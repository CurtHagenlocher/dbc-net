<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The samples consume Adbc.Drivers.Build from this repository's local package output,
    so pack it before building a sample:

      dotnet pack src\Adbc.Drivers.Build\Adbc.Drivers.Build.csproj
  -->
  <packageSources>
    <clear />
    <!-- Forward slashes: this path is read by NuGet directly, not normalized by MSBuild. -->
    <add key="adbc-local" value="../artifacts/package" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
